apiVersion: apps/v1
kind: Deployment
metadata:
  name: todo-app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: todo
  template:
    metadata:
      labels:
        app: todo
    spec:
      automountServiceAccountToken: false   # ✅ security fix
      containers:
      - name: todo
        image: todo-app:latest              # ✅ version tag
        ports:
        - containerPort: 5000

        resources:                          # ✅ required for Sonar
          requests:
            cpu: "250m"
            memory: "256Mi"
          limits:
            cpu: "500m"
            memory: "512Mi"